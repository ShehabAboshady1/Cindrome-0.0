<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome - Watchlist</title>
    <link rel="icon" type="image/png" href="/assets/logos/cindrome-logo.png">

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/hero.css">
    <link rel="stylesheet" href="/css/cards.css">
    <link rel="stylesheet" href="/css/lists-carousel.css">
    <link rel="stylesheet" href="/css/carousel.css">
    <link rel="stylesheet" href="/css/pages/watchlist.css">
    <link rel="stylesheet" href="/css/mini-card.css">
    <link rel="stylesheet" href="/css/modals.css">
</head>

<body class="logged-in">
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <!-- WATCHLIST MAIN SECTION -->
    <main class="watchlist-main-section">

        <!-- 1. HEADER (TITLE & BADGE) -->
        <section class="watchlist-header-section">
            <h1 class="watchlist-title">Watchlist</h1>
        </section>

        <!-- 2. FILTER BAR SECTION -->
        <section class="watchlist-filter-section" aria-label="Content Filters">
            <form class="filter-bar-container" role="search" onSubmit="return false;">

                <!-- Inline Search Box -->
                <div class="filter-search-box">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="filterSearchInput" placeholder="Search title." aria-label="Search title">
                </div>

                <div class="filter-v-divider" role="separator"></div>

                <!-- Type Selector Pills -->
                <fieldset class="type-selector" aria-label="Content Type">
                    <button class="type-pill active" type="button" data-type="all">All</button>
                    <button class="type-pill" type="button" data-type="anime">Anime</button>
                    <button class="type-pill" type="button" data-type="movies">Movies</button>
                    <button class="type-pill" type="button" data-type="series">Series</button>
                </fieldset>

                <div class="filter-v-divider" role="separator"></div>

                <!-- Dropdowns Group -->
                <div class="dropdowns-group">

                    <!-- Genre Dropdown -->
                    <details class="css-dropdown">
                        <summary class="dropdown-selected">
                            <span class="selected-text">Genre</span>
                            <span class="dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="dropdown-list">
                            <li class="dropdown-item">Action</li>
                            <li class="dropdown-item">Sci-Fi</li>
                            <li class="dropdown-item">Drama</li>
                            <li class="dropdown-item">Mystery</li>
                            <li class="dropdown-item">Psychological</li>
                            <li class="dropdown-item">Fantasy</li>
                            <li class="dropdown-item">Comedy</li>
                        </ul>
                    </details>

                    <!-- Rating Dropdown -->
                    <details class="css-dropdown">
                        <summary class="dropdown-selected">
                            <span class="selected-text">Rating</span>
                            <span class="dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="dropdown-list">
                            <li class="dropdown-item">★ 9.0+</li>
                            <li class="dropdown-item">★ 8.0+</li>
                            <li class="dropdown-item">★ 7.0+</li>
                            <li class="dropdown-item">★ 6.0+</li>
                            <li class="dropdown-item">★ 5.0+</li>
                            <li class="dropdown-item">Lower</li>
                        </ul>
                    </details>

                    <!-- Sort By Dropdown -->
                    <details class="css-dropdown">
                        <summary class="dropdown-selected">
                            <span class="selected-text">Sort By</span>
                            <span class="dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="dropdown-list">
                            <li class="dropdown-item">Newest</li>
                            <li class="dropdown-item">Popular</li>
                            <li class="dropdown-item">Rating</li>
                        </ul>
                    </details>

                    <!-- Year Dropdown -->
                    <details class="css-dropdown">
                        <summary class="dropdown-selected">
                            <span class="selected-text">Year</span>
                            <span class="dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="dropdown-list">
                            <li class="dropdown-item">2026</li>
                            <li class="dropdown-item">2025</li>
                            <li class="dropdown-item">2024</li>
                            <li class="dropdown-item">2023</li>
                            <li class="dropdown-item">2022</li>
                            <li class="dropdown-item">2021</li>
                            <li class="dropdown-item">2020</li>
                            <li class="dropdown-item">2010s</li>
                            <li class="dropdown-item">2000s</li>
                            <li class="dropdown-item">90s</li>
                            <li class="dropdown-item">80s</li>
                            <li class="dropdown-item">Classics</li>
                        </ul>
                    </details>

                </div>

                <!-- Reset Button -->
                <button class="reset-filter-btn" type="reset" aria-label="Reset Filters" title="Reset Filters">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <path d="M3 3v5h5"></path>
                    </svg>
                </button>

            </form>
        </section>

