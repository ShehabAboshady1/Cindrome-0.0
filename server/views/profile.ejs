<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome - Profile</title>
    <link rel="icon" type="image/png" href="assets/logos/cindrome-logo.png">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/main.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/hero.css">
    <link rel="stylesheet" href="css/cards.css">
    <link rel="stylesheet" href="css/lists-carousel.css">
    <link rel="stylesheet" href="css/list.css">
    <link rel="stylesheet" href="css/carousel.css">
    <link rel="stylesheet" href="css/mini-card.css">
    <link rel="stylesheet" href="css/pages/profile.css">
    <link rel="stylesheet" href="css/modals.css">

</head>

<body class="profile-page-self logged-in">
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <!-- BANNER -->
    <div class="profile-banner">
        <div class="banner-overlay"></div>
    </div>

    <!-- PROFILE HEADER -->
    <div class="profile-header-container">
        <div class="profile-avatar-wrapper">
            <img src="assets/avatars/shehab.jpg" alt="Shehab Aboshady" class="profile-avatar"
                onerror="this.src='assets/profile-avatar.jpg'">
        </div>

        <div class="profile-info-bar">
            <div class="profile-main-row">
                <div class="user-titles">
                    <h1 class="display-name">Shehab Aboshady</h1>
                    <!-- 🌟 الثلاثة عناصر مجمعين في صف واحد إجباري 🌟 -->
                    <div class="user-meta-row">
                        <span class="username">@Shehab_Aboshady</span>
                        <span class="genre-badge"><i class="fa-solid fa-film"></i> Sci-Fi & Shonen</span>
                        <span class="private-badge" title="Private Account"><i class="fa-solid fa-lock"></i></span>
                    </div>
                </div>

                <div class="profile-actions-inline">
                    <button class="btn-profile-pill btn-edit self-only" id="editProfileBtn">
                        <i class="fa-solid fa-pen"></i> Edit Profile
                    </button>
                    <a href="/settings">
                        <button class="btn-profile-pill btn-settings self-only" title="Settings">
                            <i class="fa-solid fa-gear"></i>
                        </button>
                    </a>

                    <button id="followBtn" class="btn-profile-pill btn-follow other-only" type="button"
                        aria-pressed="false" aria-label="Follow user">
                        <i class="fa-solid fa-user-plus"></i>
                        <span class="btn-label">Follow</span>
                    </button>
                    <button id="notifyBtn" class="btn-profile-pill btn-notify other-only" type="button"
                        title="Turn on notifications" aria-label="Turn on notifications" aria-pressed="false">
                        <i class="fa-solid fa-bell"></i>
                    </button>
                </div>
            </div>

            <p class="user-bio">
                Cinephile, anime watcher, and web dev. Tracking my journey through movies, TV shows, and weekly anime
                episodes.
            </p>

            <div class="profile-stats">
                <div class="stat-item">
                    <span class="stat-value">1,240</span>
                    <span class="stat-label">Followers</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">385</span>
                    <span class="stat-label">Following</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">842</span>
                    <span class="stat-label">Total Watched</span>
                </div>
            </div>
        </div>
    </div>

    <!-- الحاوية المجمعة للمحتوى الخاص بالتغبيش -->
    <div class="profile-restricted-wrapper">

        <div class="profile-private-overlay">
            <div class="private-lock-icon">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h2 class="private-title">This Account is Private</h2>
            <p class="private-subtitle">Follow @Shehab_Aboshady to see their favorite titles, currently watching, and
                lists.</p>
        </div>

        <!-- MAIN TABS BAR -->
        <nav class="profile-main-tabs" aria-label="Profile sections">
            <div class="tabs-container">
                <button class="profile-tab-btn is-active" type="button"
                    onclick="switchProfileTab('overview', this)">Overview</button>
                <button class="profile-tab-btn" type="button"
                    onclick="switchProfileTab('reviews', this)">Reviews</button>
                <button class="profile-tab-btn" type="button" onclick="switchProfileTab('lists', this)">Lists</button>
            </div>
        </nav>

        <!-- MAIN SECTION -->
        <main class="profile-main-container" id="mainContainer">

            <section class="profile-content">

                <!-- TAB 1: OVERVIEW PANEL -->
                <div id="panel-overview" class="profile-tab-panel active-panel">

                    <div class="profile-card-box">
                        <div class="profile-box-header">
                            <h2 class="profile-box-title"><i class="fa-solid fa-star"></i> Favorites</h2>
                            <div class="carousel-controls">
                                <button class="carousel-btn" aria-label="Previous" type="button"
                                    onclick="scrollFavorites(-1)">&#10094;</button>
                                <button class="carousel-btn" aria-label="Next" type="button"
                                    onclick="scrollFavorites(1)">&#10095;</button>
                            </div>
                        </div>

                        <div class="profile-cards-wrapper" id="favoritesRow">
                            <div class="content-card">
                                <img src="assets/posters/poster-vinlandsaga.webp" alt="Vinland Saga"
                                    class="card-poster">
                                <div class="card-overlay">
                                    <div class="card-top-row">
                                        <span class="type-badge">ANIME</span>
                                        <div class="rating-box">
                                            <span class="rating-label">MAL</span>
                                            <span class="rating-score">⭐ 8.8</span>
                                        </div>
                                    </div>
                                    <div class="card-bottom-content">
                                        <div class="title-row">
                                            <h3 class="card-title">Vinland Saga</h3>
                                            <span class="age-badge">TV-MA</span>
                                        </div>
                                        <div class="meta-row">
                                            <span>2 Seasons • 2019</span>
                                        </div>
                                        <div class="card-actions">
                                            <a href="/details" class="btn-details">Details</a>
                                            <button class="btn-watchlist" title="Add to Watchlist">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="content-card">
                                <img src="https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg"
                                    alt="Interstellar" class="card-poster">
                                <div class="card-overlay">
                                    <div class="card-top-row">
                                        <span class="type-badge">MOVIE</span>
                                        <div class="rating-box">
                                            <span class="rating-label">IMDb</span>
                                            <span class="rating-score">⭐ 8.7</span>
                                        </div>
                                    </div>
                                    <div class="card-bottom-content">
                                        <div class="title-row">
                                            <h3 class="card-title">Interstellar</h3>
                                            <span class="age-badge">PG-13</span>
                                        </div>
                                        <div class="meta-row">
                                            <span>2h 49m • 2014</span>
                                        </div>
                                        <div class="card-actions">
                                            <a href="/details" class="btn-details">Details</a>
                                            <button class="btn-watchlist" title="Add to Watchlist">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="content-card">
                                <img src="assets/posters/poster-dune2.webp" alt="Dune: Part Two" class="card-poster">
                                <div class="card-overlay">
                                    <div class="card-top-row">
                                        <span class="type-badge">MOVIE</span>
                                        <div class="rating-box">
                                            <span class="rating-label">IMDb</span>
                                            <span class="rating-score">⭐ 8.5</span>
                                        </div>
                                    </div>
                                    <div class="card-bottom-content">
                                        <div class="title-row">
                                            <h3 class="card-title">Dune: Part Two</h3>
                                            <span class="age-badge">PG-13</span>
                                        </div>
                                        <div class="meta-row">
                                            <span>2h 46m • 2024</span>
                                        </div>
                                        <div class="card-actions">
                                            <a href="/details" class="btn-details">Details</a>
                                            <button class="btn-watchlist" title="Add to Watchlist">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="content-card">
                                <img src="assets/posters/poster-breakingbad.webp" alt="Breaking Bad"
                                    class="card-poster">
                                <div class="card-overlay">
                                    <div class="card-top-row">
                                        <span class="type-badge">SERIES</span>
                                        <div class="rating-box">
                                            <span class="rating-label">IMDb</span>
                                            <span class="rating-score">⭐ 9.5</span>
                                        </div>
                                    </div>
                                    <div class="card-bottom-content">
                                        <div class="title-row">
                                            <h3 class="card-title">Breaking Bad</h3>
                                            <span class="age-badge">TV-MA</span>
                                        </div>
                                        <div class="meta-row">
                                            <span>5 Seasons • 2008</span>
                                        </div>
                                        <div class="card-actions">
                                            <a href="/details" class="btn-details">Details</a>
                                            <button class="btn-watchlist" title="Add to Watchlist">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="content-card">
                                <img src="assets/posters/poster-onepiece.webp" alt="One Piece" class="card-poster">
                                <div class="card-overlay">
                                    <div class="card-top-row">
                                        <span class="type-badge">ANIME</span>
                                        <div class="rating-box">
                                            <span class="rating-label">IMDb</span>
                                            <span class="rating-score">⭐ 9.0</span>
