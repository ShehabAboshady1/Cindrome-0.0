<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Cindrome</title>
    <link rel="icon" type="image/png" href="/assets/logos/cindrome-logo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="/css/pages/sign-up.css">
</head>

<body>
    <main class="auth-container signup-container">
        <div class="auth-card signup-card">
            <div class="auth-header">
                <a href="/" class="auth-logo-link">
                    <img src="/assets/logos/no background logo.png" alt="Cindrome Logo" class="auth-logo">
                </a>
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Join Cindrome to track your movies & shows</p>
            </div>

            <% if (locals.errorMessage) { %>
                <div
                    style="background: rgba(255, 71, 87, 0.1); border: 1px solid #ff4757; color: #ff4757; padding: 10px; border-radius: 6px; text-align: center; margin-bottom: 20px; font-weight: bold;">
                    <%= errorMessage %>
                </div>
                <% } %>

                    <form class="auth-form" id="signUpForm" action="/register" method="POST" novalidate>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="username">Username</label>
                                <input type="text" id="username" name="username" placeholder="Username" required
                                    autocomplete="username">
                                <span class="field-error-msg" id="usernameError"></span>
                            </div>

                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" name="email" id="email" placeholder="name@example.com" required
                                    autocomplete="email">
                                <span class="field-error-msg" id="emailError"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="password">Password</label>
                                <div class="password-input-wrapper">
                                    <input type="password" name="password" id="password" placeholder="••••••••" required
                                        autocomplete="new-password">
                                    <button type="button" class="toggle-password-btn" id="togglePasswordBtn"
                                        aria-label="Toggle password visibility">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <span class="field-error-msg" id="passwordError"></span>
                            </div>

                            <div class="password-requirements">
                                <p class="req-title">Password must contain:</p>
                                <ul class="req-list">
                                    <li class="req-item" id="req-length">
                                        <span class="req-icon">•</span> Min 8 characters
                                    </li>
                                    <li class="req-item" id="req-uppercase">
                                        <span class="req-icon">•</span> Uppercase letter (A-Z)
                                    </li>
                                    <li class="req-item" id="req-number-special">
                                        <span class="req-icon">•</span> Number or special character
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="signup-bottom-row">
                            <div class="form-options">
                                <label class="toggle-container">
                                    <input type="checkbox" id="terms">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-label">I agree to Terms & Policy</span>
                                </label>
                            </div>

                            <button type="submit" class="auth-btn" id="submitBtn">Create Account</button>
                        </div>
                        <span class="field-error-msg terms-error" id="termsError"></span>
                    </form>

                    <div class="auth-footer">
                        <p>Already have an account? <a href="/sign-in">Sign in</a></p>
                    </div>
        </div>
    </main>

    <script src="/js/pages/sign-up.js"></script>
</body>

</html>