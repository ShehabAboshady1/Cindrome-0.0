<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome - Settings</title>
    <link rel="icon" type="image/png" href="/assets/logos/cindrome-logo.png">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/pages/settings.css">
    <link rel="stylesheet" href="/css/modals.css">
</head>

<body class="settings-page logged-in">
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <main class="settings-wrapper">
        <div class="settings-header">
            <h1 class="settings-title">Settings</h1>
            <p class="settings-subtitle">Manage your account security, privacy, and notifications.</p>
        </div>

        <div class="settings-container">
            <!-- Sidebar Navigation -->
            <aside class="settings-sidebar">
                <button class="settings-tab-btn is-active" data-tab="account" type="button">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>Security</span>
                </button>
                <button class="settings-tab-btn" data-tab="privacy" type="button">
                    <i class="fa-solid fa-lock"></i>
                    <span>Privacy</span>
                </button>
                <button class="settings-tab-btn" data-tab="notifications" type="button">
                    <i class="fa-regular fa-bell"></i>
                    <span>Alerts</span>
                </button>
            </aside>

            <!-- Main Content Area -->
            <section class="settings-content">

                <!-- TAB 1: ACCOUNT SECURITY -->
                <div id="tab-account" class="settings-panel active-panel">
                    <h2 class="panel-title">Account Security</h2>

                    <h3 class="panel-subtitle">Change Email Address</h3>
                    <form id="emailForm" onsubmit="return false;">
                        <div class="settings-form-row">
                            <div class="settings-form-group">
                                <label class="settings-label">Current Email</label>
                                <input type="email" class="settings-input" value="cindrome.me@gmail.com" readonly>
                            </div>
                            <div class="settings-form-group">
                                <label class="settings-label">New Email</label>
                                <input type="email" id="newEmailInput" class="settings-input"
                                    placeholder="Enter new email address">
                            </div>
                        </div>
                        <p class="input-hint" style="margin-top: -10px; margin-bottom: 20px;">
                            <i class="fa-solid fa-circle-info"></i> For your security, a verification link will be sent
                            to
                            your current email first.
                        </p>
                        <div class="settings-actions-left">
                            <button type="button" id="changeEmailBtn" class="btn-secondary-action">Change Email</button>
                        </div>
                    </form>

                    <hr class="settings-divider">

                    <h3 class="panel-subtitle">Change Password</h3>
                    <form id="passwordForm" onsubmit="return false;">
                        <div class="settings-form-group">
                            <label class="settings-label">Current Password</label>
                            <input type="password" id="currentPasswordInput" class="settings-input"
                                placeholder="Enter current password">
                        </div>
                        <div class="settings-form-row">
                            <div class="settings-form-group">
                                <label class="settings-label">New Password</label>
                                <input type="password" id="newPasswordInput" class="settings-input"
                                    placeholder="New password">
                            </div>
                            <div class="settings-form-group">
                                <label class="settings-label">Confirm Password</label>
                                <input type="password" id="confirmPasswordInput" class="settings-input"
                                    placeholder="Confirm new password">
                            </div>
                        </div>
                        <div class="settings-actions-left">
                            <button type="button" id="updatePasswordBtn" class="btn-save">Update Password</button>
                        </div>
                    </form>

                    <hr class="settings-divider">

                    <h3 class="panel-subtitle">Two-Factor Authentication (2FA)</h3>
                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4 class="toggle-title">Enable 2FA</h4>
                            <p class="toggle-desc">Require an extra security code sent to your email or mobile device
                                when logging in.</p>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="twoFactorToggle">
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <hr class="settings-divider">

                    <h3 class="panel-subtitle danger-text">Danger Zone</h3>
                    <p class="input-hint" style="margin-bottom: 12px;">Once you delete your account, there is no going
                        back. All your reviews, lists, and diary logs will be permanently removed.</p>
                    <button type="button" id="openDeleteModalBtn" class="btn-danger">Delete Account</button>
                </div>

                <!-- TAB 2: PRIVACY -->
                <div id="tab-privacy" class="settings-panel" style="display: none;">
                    <h2 class="panel-title">Privacy Settings</h2>

                    <p class="input-hint" style="margin-bottom: 24px;">Control who can see your activity and how your
                        content is featured on Cindrome.</p>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4 class="toggle-title">Private Account</h4>
                            <p class="toggle-desc">Only approved followers can see your profile, lists, and reviews.</p>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="privateAccountToggle">
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4 class="toggle-title">Allow Featuring</h4>
                            <p class="toggle-desc">Allow Cindrome to feature your highly-rated lists and reviews on the
                                Home page.</p>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="allowFeaturingToggle" checked>
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div class="settings-actions">
                        <button type="button" id="savePrivacyBtn" class="btn-save">Save Privacy Settings</button>
                    </div>
                </div>

                <!-- TAB 3: NOTIFICATIONS -->
                <div id="tab-notifications" class="settings-panel" style="display: none;">
                    <h2 class="panel-title">Email Notifications</h2>

                    <p class="input-hint" style="margin-bottom: 24px;">Control which emails Cindrome sends to your
                        inbox.</p>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4 class="toggle-title">New Followers</h4>
                            <p class="toggle-desc">Get an email when someone follows your account.</p>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="notifyFollowersToggle" checked>
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4 class="toggle-title">Review Interactions</h4>
                            <p class="toggle-desc">Get an email when someone likes or comments on your review.</p>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="notifyReviewsToggle" checked>
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div class="toggle-group">
                        <div class="toggle-info">
                            <h4 class="toggle-title">Cindrome Newsletter</h4>
                            <p class="toggle-desc">Receive weekly updates on trending movies, series, and anime.</p>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="notifyNewsletterToggle">
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div class="settings-actions">
                        <button type="button" id="saveNotificationsBtn" class="btn-save">Save Notification
                            Settings</button>
                    </div>
                </div>

            </section>
        </div>
    </main>

    <%- include("partials/footer.ejs") %>

        <!-- 🌟 DELETE ACCOUNT CONFIRMATION MODAL 🌟 -->
        <div id="deleteAccountModal" class="settings-modal-overlay" style="display: none;">
            <div class="settings-modal-card">
                <div class="settings-modal-header">
                    <h3 class="danger-text"><i class="fa-solid fa-triangle-exclamation"></i> Delete Account</h3>
                    <button type="button" class="close-modal-btn" id="closeDeleteModalBtn">&times;</button>
                </div>
                <div class="settings-modal-body">
                    <p>Are you sure you want to delete your account? This action is permanent and cannot be undone.</p>
                    <p class="input-hint">All your diary entries, watched history, custom lists, and written reviews
                        will be
                        permanently deleted.</p>
                </div>
                <div class="settings-modal-footer">
                    <button type="button" class="btn-secondary-action" id="cancelDeleteBtn">Cancel</button>
                    <button type="button" class="btn-danger-confirm" id="confirmDeleteBtn">Yes, Delete Account</button>
                </div>
            </div>
        </div>
        <%- include("partials/modals/search-modal.ejs") %>
            <%- include("partials/modals/log-modal.ejs") %>
                <!-- Scripts -->
                <script src="/js/modals.js"></script>
                <script src="/js/pages/settings.js"></script>
</body>

</html>