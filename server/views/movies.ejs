<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome - Movies</title>
    <link rel="icon" type="image/png" href="assets/logos/cindrome-logo.png">
    <link rel="stylesheet" href="css/main.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/hero.css">
    <link rel="stylesheet" href="css/cards.css">
    <link rel="stylesheet" href="css/carousel.css">
    <link rel="stylesheet" href="css/list.css">
    <link rel="stylesheet" href="css/modals.css">
</head>

<body class="<%= locals.user ? 'logged-in' : 'logged-out' %>">
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <section class="hero-section"
        style="background-image: url('<%= heroMovie && heroMovie.backdrop ? heroMovie.backdrop : 'assets/backdrops/backdrop-thedeathofrobinhood.webp' %>');">
        <div class="hero-overlay"></div>
        <div class="hero-container">
            <div class="hero-content">
                <div class="hero-tags">
                    <span class="badge trending-badge">🔥 Trending #1</span>
                    <span class="badge category-badge">Movie</span>
                </div>
                <h1 class="hero-title">
                    <%= heroMovie ? heroMovie.title : 'The Death of Robin Hood' %>
                </h1>
                <div class="hero-meta">
                    <span class="rating">⭐ <%= heroMovie ? heroMovie.score : '7.8' %> <i>/ 10</i></span>
                    <span class="meta-dot">•</span>
                    <span class="duration">
                        <%= heroMovie ? heroMovie.duration : '2h 02m' %>
                    </span>
                    <span class="meta-dot">•</span>
                    <span class="year">
                        <%= heroMovie ? heroMovie.year : '2026' %>
                    </span>
                    <span class="meta-dot">•</span>
                    <span class="genre">
                        <%= heroMovie ? heroMovie.genres : 'Action, Adventure, Drama' %>
                    </span>
                </div>
                <p class="hero-description">
                    <%= heroMovie ? heroMovie.overview : 'Grappling with his past after a life of crime and murder...'
                        %>
                </p>
                <div class="hero-actions">
                    <a href="/details?id=<%= heroMovie ? heroMovie.id : '' %>&type=movie" class="btn btn-primary">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        View Movie
                    </a>

                    <button type="button"
                        class="btn btn-secondary watchlist-btn hero-watchlist-btn <%= heroMovie && locals.watchlistMap && locals.watchlistMap.includes(heroMovie.id.toString()) ? 'added' : '' %>"
                        onclick="toggleWatchlist(this, <%= heroMovie ? heroMovie.id : '' %>, 'movie')">
                        <span class="default-content">Add to Watchlist</span>
                        <span class="added-content"><i class="fa-solid fa-minus" style="margin-right: 6px;"></i>
                            Added</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Carousel Section 1: 2026 Latest Releases -->
    <section class="carousel-section">
        <div class="carousel-header">
            <h2 class="carousel-title">🔥 2026 Latest Releases</h2>
            <div class="carousel-controls">
                <button class="carousel-btn" aria-label="Previous">&#10094;</button>
                <button class="carousel-btn" aria-label="Next">&#10095;</button>
            </div>
        </div>
        <div class="carousel-track">
            <% if (latestMovies && latestMovies.length> 0) { %>
                <% latestMovies.forEach(item=> { %>
                    <div class="content-card">
                        <img src="<%= item.poster %>" alt="<%= item.title %>" class="card-poster">
                        <div class="card-overlay">
                            <div class="card-top-row">
                                <span class="type-badge">
                                    <%= item.type %>
                                </span>
                                <div class="rating-box">
                                    <span class="rating-label">IMDB</span>
                                    <span class="rating-score">⭐ <%= item.score %></span>
                                </div>
                            </div>
                            <div class="card-bottom-content">
                                <div class="title-row">
                                    <h3 class="card-title" title="<%= item.title %>">
                                        <%= item.title %>
                                    </h3>
                                    <span class="age-badge">
                                        <%= item.ageBadge %>
                                    </span>
                                </div>
                                <div class="meta-row">
                                    <span>
                                        <%= item.subtitle %>
                                    </span>
                                </div>
                                <div class="card-actions">
                                    <a href="/details?id=<%= item.id %>&type=movie" class="btn-details">Details</a>
                                    <button
                                        class="btn-watchlist <%= locals.watchlistMap && locals.watchlistMap.includes(item.id.toString()) ? 'added' : '' %>"
                                        title="<%= locals.watchlistMap && locals.watchlistMap.includes(item.id.toString()) ? 'Remove from Watchlist' : 'Toggle Watchlist' %>"
                                        onclick="toggleWatchlist(this, <%= item.id %>, '<%= item.mediaType %>')">
                                        <span class="icon-plus">+</span>
                                        <span class="icon-minus">-</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                        <% } %>
        </div>
    </section>

