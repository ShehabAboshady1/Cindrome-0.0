<section id="comments-section" class="list-comments-wrapper"
    data-target-id="<%= typeof targetId !== 'undefined' ? targetId : '' %>"
    data-target-type="<%= typeof targetType !== 'undefined' ? targetType : 'review' %>">
    <div class="comments-header-row">
        <h2 class="comments-title">Comments <span class="comments-count">
                <%= typeof commentsCount !=='undefined' ? commentsCount : 0 %>
            </span></h2>
    </div>

    <!-- إضافة تعليق رئيسي -->
    <div class="add-comment-box">
        <img src="<%= locals.user && locals.user.avatar_url ? locals.user.avatar_url : '/assets/profile-avatar.jpg' %>"
            alt="My Avatar" class="comment-avatar" onerror="this.src='/assets/profile-avatar.jpg'">
        <div class="modern-input-wrapper">
            <textarea class="comment-textarea" placeholder="Add a comment." rows="1"></textarea>
            <button class="modern-post-btn" title="Post Comment">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>

    <hr class="comments-divider">

    <!-- قائمة التعليقات من الداتابيز -->
    <div class="comments-list" id="commentsListContainer">
        <% if (typeof mainComments !=='undefined' && mainComments.length> 0) { %>
            <% mainComments.forEach(comment=> { %>
                <div class="comment-thread" data-comment-id="<%= comment.id %>">

                    <!-- التعليق الأساسي -->
                    <div class="single-comment">
                        <a href="/profile/<%= comment.username %>">
                            <img src="<%= comment.avatar_url || '/assets/profile-avatar.jpg' %>"
                                alt="<%= comment.username %>" class="comment-avatar"
                                onerror="this.src='/assets/profile-avatar.jpg'">
                        </a>
                        <div class="comment-content-wrapper">
                            <div class="comment-header">
                                <span class="comment-user">
                                    <a href="/profile/<%= comment.username %>"
                                        style="color: inherit; text-decoration: none;">@<%= comment.username %></a>
                                </span>
                                <span class="comment-time">
                                    <% const d=new Date(comment.created_at); %>
                                        <%= d.toLocaleDateString('en-US', { month: 'short' , day: 'numeric' }) %>
                                </span>
                            </div>
                            <p class="comment-text">
                                <%- comment.content %>
                            </p>

                            <!-- أزرار تفاعل التعليق الأساسي -->
                            <div class="comment-interactions">
                                <button
                                    class="interaction-btn comment-like-btn <%= comment.is_liked_by_user ? 'is-liked' : '' %>"
                                    data-comment-id="<%= comment.id %>">
                                    <svg class="interactive-svg like-svg" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                        </path>
                                    </svg> <span>
                                        <%= comment.likes_count %>
                                    </span>
                                </button>
                                <button class="interaction-btn reply-trigger">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                        </path>
                                    </svg> Reply
                                </button>
                            </div>

                            <!-- صندوق الرد للتعليق الأساسي -->
                            <div class="inline-reply-box">
                                <img src="<%= locals.user && locals.user.avatar_url ? locals.user.avatar_url : '/assets/profile-avatar.jpg' %>"
                                    alt="My Avatar" class="comment-avatar small-avatar reply-avatar"
                                    onerror="this.src='/assets/profile-avatar.jpg'">
                                <div class="modern-input-wrapper">
                                    <textarea class="comment-textarea"
                                        placeholder="Reply to @<%= comment.username %>..." rows="1"></textarea>
                                    <button class="modern-post-btn" title="Send Reply">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                        </svg>
                                    </button>
                                </div>
                                <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                            </div>
                        </div>
                    </div>

                    <!-- الردود المتداخلة -->
                    <div class="nested-replies">
                        <% if (comment.replies && comment.replies.length> 0) { %>
                            <% comment.replies.forEach(reply=> { %>
                                <div class="single-comment sub-reply-comment">
                                    <a href="/profile/<%= reply.username %>">
                                        <img src="<%= reply.avatar_url || '/assets/profile-avatar.jpg' %>"
                                            alt="<%= reply.username %>" class="comment-avatar small-avatar"
                                            onerror="this.src='/assets/profile-avatar.jpg'">
                                    </a>
                                    <div class="comment-content-wrapper">
                                        <div class="comment-header">
                                            <span class="comment-user">
                                                <a href="/profile/<%= reply.username %>"
                                                    style="color: inherit; text-decoration: none;">@<%= reply.username
                                                        %></a>
                                            </span>
                                            <span class="comment-time">
                                                <% const rd=new Date(reply.created_at); %>
                                                    <%= rd.toLocaleDateString('en-US', { month: 'short' , day: 'numeric'
                                                        }) %>
                                            </span>
                                        </div>
                                        <p class="comment-text">
                                            <%- reply.content %>
                                        </p>

                                        <!-- أزرار تفاعل الرد -->
                                        <div class="comment-interactions">
                                            <button
                                                class="interaction-btn comment-like-btn <%= reply.is_liked_by_user ? 'is-liked' : '' %>"
                                                data-comment-id="<%= reply.id %>">
                                                <svg class="interactive-svg like-svg" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                                    </path>
                                                </svg> <span>
                                                    <%= reply.likes_count %>
                                                </span>
                                            </button>
                                            <button class="interaction-btn reply-trigger">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2">
                                                    <path
                                                        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                                    </path>
                                                </svg> Reply
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } %>
                    </div>
                </div>
                <% }); %>
                    <% } else { %>
                        <div class="no-comments-msg"
                            style="text-align: center; color: rgba(241,227,200,0.4); font-size: 14px; padding: 20px;">
                            No comments yet. Be the first to share your thoughts!
                        </div>
                        <% } %>
    </div>
</section>

<!-- Template للكومنت الجديد أو الرد عشان الجافاسكريبت يستخدمه -->
<template id="commentTemplate">
    <div class="comment-thread">
        <div class="single-comment">
            <a href="#" class="comment-user-link">
                <img src="" alt="User" class="comment-avatar" onerror="this.src='/assets/profile-avatar.jpg'">
            </a>
            <div class="comment-content-wrapper">
                <div class="comment-header">
                    <span class="comment-user">
                        <a href="#" class="comment-user-link-text" style="color: inherit; text-decoration: none;"></a>
                    </span>
                    <span class="comment-time">Just now</span>
                </div>
                <p class="comment-text"></p>
                <div class="comment-interactions">
                    <button class="interaction-btn comment-like-btn" data-comment-id="">
                        <svg class="interactive-svg like-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path
                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                            </path>
                        </svg> <span>0</span>
                    </button>
                    <button class="interaction-btn reply-trigger">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path
                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                            </path>
                        </svg> Reply
                    </button>
                </div>
                <div class="inline-reply-box">
                    <img src="" alt="My Avatar" class="comment-avatar small-avatar reply-avatar"
                        onerror="this.src='/assets/profile-avatar.jpg'">
                    <div class="modern-input-wrapper">
                        <textarea class="comment-textarea" placeholder="Reply..." rows="1"></textarea>
                        <button class="modern-post-btn" title="Send Reply">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                    <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                </div>
            </div>
        </div>
        <div class="nested-replies"></div>
    </div>
</template>