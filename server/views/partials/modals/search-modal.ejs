<div class="search-modal-overlay" id="searchModal" style="display: none;">
    <div class="search-modal-container">

        <button class="close-modal-btn" aria-label="Close search">&times;</button>

        <section class="g-search-section" aria-label="Content Filters">
            <form class="g-filter-bar-container" role="search" onSubmit="return false;">

                <div class="g-filter-search-box">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="filterSearchInput" placeholder="Search title..." aria-label="Search title"
                        autofocus>
                </div>

                <div class="g-filter-v-divider" role="separator"></div>

                <fieldset class="g-type-selector" aria-label="Content Type">
                    <button class="g-type-pill active" type="button">All</button>
                    <button class="g-type-pill" type="button">Anime</button>
                    <button class="g-type-pill" type="button">Movies</button>
                    <button class="g-type-pill" type="button">Series</button>
                </fieldset>

                <div class="g-filter-v-divider" role="separator"></div>

                <div class="g-dropdowns-group">

                    <!-- Genre Dropdown -->
                    <details class="g-css-dropdown">
                        <summary class="g-dropdown-selected">
                            <span>Genre</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item">Action</li>
                            <li class="g-dropdown-item">Sci-Fi</li>
                            <li class="g-dropdown-item">Drama</li>
                            <li class="g-dropdown-item">Mystery</li>
                            <li class="g-dropdown-item">Psychological</li>
                            <li class="g-dropdown-item">Fantasy</li>
                            <li class="g-dropdown-item">Comedy</li>
                        </ul>
                    </details>

                    <!-- Rating Dropdown -->
                    <details class="g-css-dropdown">
                        <summary class="g-dropdown-selected">
                            <span>Rating</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item">★ 9.0+</li>
                            <li class="g-dropdown-item">★ 8.0+</li>
                            <li class="g-dropdown-item">★ 7.0+</li>
                            <li class="g-dropdown-item">★ 6.0+</li>
                            <li class="g-dropdown-item">★ 5.0+</li>
                            <li class="g-dropdown-item">Lower</li>
                        </ul>
                    </details>

                    <!-- Sort By Dropdown -->
                    <details class="g-css-dropdown">
                        <summary class="g-dropdown-selected">
                            <span>Sort By</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item">Newest</li>
                            <li class="g-dropdown-item">Popular</li>
                            <li class="g-dropdown-item">Rating</li>
                        </ul>
                    </details>

                    <!-- Year Dropdown -->
                    <details class="g-css-dropdown">
                        <summary class="g-dropdown-selected">
                            <span>Year</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item">2026</li>
                            <li class="g-dropdown-item">2025</li>
                            <li class="g-dropdown-item">2024</li>
                            <li class="g-dropdown-item">2023</li>
                            <li class="g-dropdown-item">2022</li>
                            <li class="g-dropdown-item">2021</li>
                            <li class="g-dropdown-item">2020</li>
                            <li class="g-dropdown-item">2010s</li>
                            <li class="g-dropdown-item">2000s</li>
                            <li class="g-dropdown-item">90s</li>
                            <li class="g-dropdown-item">80s</li>
                            <li class="g-dropdown-item">Classics</li>
                        </ul>
                    </details>

                </div>

                <button class="g-reset-filter-btn" type="reset" aria-label="Reset Filters" title="Reset Filters">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <path d="M3 3v5h5"></path>
                    </svg>
                </button>

            </form>
        </section>
    </div>
</div>