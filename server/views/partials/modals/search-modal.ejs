<div class="search-modal-overlay" id="searchModal" style="display: none;">
    <div class="search-modal-container">

        <button class="close-modal-btn" aria-label="Close search">&times;</button>

        <section class="g-search-section" aria-label="Content Filters">
            <form class="g-filter-bar-container" role="search" onSubmit="return false;">

                <div class="g-filter-search-box">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="filterSearchInput" placeholder="Search title..." aria-label="Search title" autocomplete="off">
                </div>

                <div class="g-filter-v-divider" role="separator"></div>

                <fieldset class="g-type-selector" aria-label="Content Type">
                    <button class="g-type-pill active" type="button" data-type="all">All</button>
                    <button class="g-type-pill" type="button" data-type="anime">Anime</button>
                    <button class="g-type-pill" type="button" data-type="movie">Movies</button>
                    <button class="g-type-pill" type="button" data-type="tv">Series</button>
                </fieldset>

                <div class="g-filter-v-divider" role="separator"></div>

                <div class="g-dropdowns-group">

                    <details class="g-css-dropdown" id="filterGenreDropdown">
                        <summary class="g-dropdown-selected">
                            <span id="genreFilterText">Genre</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item" data-value="all">All Genres</li>
                            <li class="g-dropdown-item" data-value="action">Action</li>
                            <li class="g-dropdown-item" data-value="scifi">Sci-Fi</li>
                            <li class="g-dropdown-item" data-value="drama">Drama</li>
                            <li class="g-dropdown-item" data-value="mystery">Mystery</li>
                            <li class="g-dropdown-item" data-value="fantasy">Fantasy</li>
                            <li class="g-dropdown-item" data-value="comedy">Comedy</li>
                            <li class="g-dropdown-item" data-value="animation">Animation</li>
                        </ul>
                    </details>

                    <details class="g-css-dropdown" id="filterRatingDropdown">
                        <summary class="g-dropdown-selected">
                            <span id="ratingFilterText">Rating</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item" data-value="0">All Ratings</li>
                            <li class="g-dropdown-item" data-value="9">★ 9.0+</li>
                            <li class="g-dropdown-item" data-value="8">★ 8.0+</li>
                            <li class="g-dropdown-item" data-value="7">★ 7.0+</li>
                            <li class="g-dropdown-item" data-value="6">★ 6.0+</li>
                            <li class="g-dropdown-item" data-value="5">★ 5.0+</li>
                        </ul>
                    </details>

                    <details class="g-css-dropdown" id="filterSortDropdown">
                        <summary class="g-dropdown-selected">
                            <span id="sortFilterText">Sort By</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item" data-value="default">Default</li>
                            <li class="g-dropdown-item" data-value="newest">Newest</li>
                            <li class="g-dropdown-item" data-value="oldest">Oldest</li>
                            <li class="g-dropdown-item" data-value="rating">Rating</li>
                        </ul>
                    </details>

                    <details class="g-css-dropdown" id="filterYearDropdown">
                        <summary class="g-dropdown-selected">
                            <span id="yearFilterText">Year</span>
                            <span class="g-dropdown-arrow" aria-hidden="true">▼</span>
                        </summary>
                        <ul class="g-dropdown-list">
                            <li class="g-dropdown-item" data-value="all">All Years</li>
                            <li class="g-dropdown-item" data-value="2026">2026</li>
                            <li class="g-dropdown-item" data-value="2025">2025</li>
                            <li class="g-dropdown-item" data-value="2024">2024</li>
                            <li class="g-dropdown-item" data-value="2023">2023</li>
                            <li class="g-dropdown-item" data-value="2022">2022</li>
                            <li class="g-dropdown-item" data-value="2021">2021</li>
                            <li class="g-dropdown-item" data-value="2020">2020</li>
                            <li class="g-dropdown-item" data-value="2010s">2010s</li>
                            <li class="g-dropdown-item" data-value="2000s">2000s</li>
                            <li class="g-dropdown-item" data-value="90s">90s</li>
                            <li class="g-dropdown-item" data-value="classics">Classics</li>
                        </ul>
                    </details>

                </div>

                <button class="g-reset-filter-btn" id="globalResetBtn" type="button" aria-label="Reset Filters" title="Reset Filters">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <path d="M3 3v5h5"></path>
                    </svg>
                </button>

            </form>
        </section>

        <div class="g-results-wrapper" id="globalSearchWrapper">
            <div class="g-search-status" id="globalSearchStatus">Type to search movies, series, or anime...</div>
            <div class="g-search-results-grid" id="globalSearchResults"></div>
        </div>

    </div>
</div>

<template id="globalCardTemplate">
    <div class="content-card">
        <img src="" alt="" class="card-poster" loading="lazy">
        <div class="card-overlay">
            <div class="card-top-row">
                <span class="type-badge"></span>
                <div class="rating-box">
                    <span class="rating-label">TMDB</span>
                    <span class="rating-score"></span>
                </div>
            </div>
            <div class="card-bottom-content">
                <div class="title-row">
                    <h4 class="card-title"></h4>
                </div>
                <div class="meta-row"></div>
                <div class="card-actions">
                    <a href="" class="btn-details">Details</a>
                    <button type="button" class="btn-watchlist" title="Add to Watchlist">
                        <i class="fa-solid fa-plus icon-plus"></i>
                        <i class="fa-solid fa-check icon-minus"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</template>