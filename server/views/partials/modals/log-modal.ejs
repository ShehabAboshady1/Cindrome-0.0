<% const hasMedia=typeof media !=='undefined' && media; const isMovie=hasMedia && (media.type==='movie' || (media.badge
    && media.badge.toLowerCase()==='movie' )); const safePoster=(hasMedia && media.poster) ? media.poster
    : "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='100' height='150' viewBox='0 0 100 150'%3E%3Crect fill='%2311201f' width='100' height='150'/%3E%3Ctext fill='%23718096' font-family='sans-serif' font-size='12' dy='75' dx='20'%3ENo Poster%3C/text%3E%3C/svg%3E"
    ; %>

    <div class="log-modal-overlay" id="logModal">
        <div class="log-modal-container">

            <button class="close-modal-btn" id="closeLogModalBtn" aria-label="Close log modal">&times;</button>
            <h2 class="modal-main-title">Log Content</h2>

            <div class="log-global-search">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="logSearchInput" placeholder="Name of movie, series, or anime..."
                    autocomplete="off">
                <div class="log-search-results" id="logSearchResults"></div>
            </div>

            <div class="log-item-header">
                <input type="hidden" id="logMediaId" value="<%= hasMedia ? media.id : '' %>">
                <input type="hidden" id="logMediaType" value="<%= hasMedia ? media.type : '' %>">

                <img src="<%= safePoster %>" alt="<%= hasMedia ? media.title : 'Media Poster' %>"
                    class="log-item-poster" id="logItemPoster">

                <div class="log-item-info">
                    <span class="type-badge <%= isMovie ? 'movie-badge' : 'series-badge' %>" id="logItemBadge">
                        <%= hasMedia ? (media.badge ? media.badge.toUpperCase() : (isMovie ? 'MOVIE' : 'TV SERIES' ))
                            : 'TV SERIES' %>
                    </span>

                    <h3 class="log-item-title" id="logItemTitle">
                        <%= hasMedia ? media.title : 'Select Content' %>
                    </h3>

                    <div class="season-episode-selectors<%= isMovie ? ' is-hidden' : '' %>" id="logSeasonEpSelectors">

                        <details class="css-dropdown" id="logSeasonDropdown">
                            <summary class="dropdown-selected">
                                <span id="seasonText">Season 1</span>
                                <span class="dropdown-arrow" aria-hidden="true">▼</span>
                            </summary>
                            <ul class="dropdown-list" id="logSeasonList">
                                <% const totalSeasons=(hasMedia && media.seasonsCount) ? media.seasonsCount : 1; %>
                                    <% for(let s=1; s <=totalSeasons; s++) { %>
                                        <li class="dropdown-item" onclick="selectDropdownOption(this, 'seasonText')">
                                            Season <%= s %>
                                        </li>
                                        <% } %>
                            </ul>
                        </details>

                        <details class="css-dropdown" id="logEpisodeDropdown">
                            <summary class="dropdown-selected">
                                <span id="episodeText">All Episodes</span>
                                <span class="dropdown-arrow" aria-hidden="true">▼</span>
                            </summary>
                            <ul class="dropdown-list" id="logEpisodeList">
                                <li class="dropdown-item" onclick="selectDropdownOption(this, 'episodeText')">All
                                    Episodes</li>
                                <% if (hasMedia && Array.isArray(media.episodes) && media.episodes.length> 0) { %>
                                    <% media.episodes.forEach(ep=> { %>
                                        <li class="dropdown-item" onclick="selectDropdownOption(this, 'episodeText')">
                                            Episode <%= ep.episode_number %>
                                        </li>
                                        <% }); %>
                                            <% } %>
                            </ul>
                        </details>

                    </div>
                </div>
            </div>

            <form class="log-form" onsubmit="return false;">

                <div class="log-toolbar">
                    <div class="star-rating-input" id="starRating">
                        <i class="fa-regular fa-star rate-star" data-index="0"></i>
                        <i class="fa-regular fa-star rate-star" data-index="1"></i>
                        <i class="fa-regular fa-star rate-star" data-index="2"></i>
                        <i class="fa-regular fa-star rate-star" data-index="3"></i>
                        <i class="fa-regular fa-star rate-star" data-index="4"></i>
                    </div>

                    <div class="toolbar-divider"></div>

                    <div class="toolbar-actions">
                        <button type="button" class="icon-toggle-btn" id="likeToggle" title="Like">
                            <i class="fa-solid fa-heart"></i>
                        </button>
                        <button type="button" class="icon-toggle-btn" id="rewatchToggle" title="Rewatch">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                        <button type="button" class="icon-toggle-btn spoiler-btn" id="spoilerToggle"
                            title="Contains Spoilers">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </button>
                    </div>
                </div>

                <div class="review-group">
                    <textarea id="reviewText" class="review-textarea"
                        placeholder="Add your thoughts (Optional)..."></textarea>
                </div>

                <div class="log-footer">
                    <div class="date-group">
                        <input type="date" id="watchDate" class="date-picker-input" title="Watched On">
                    </div>

                    <div class="log-actions">
                        <button type="button" class="btn-cancel" id="cancelLogBtn">Cancel</button>
                        <button type="submit" class="btn-save-log">Log</button>
                    </div>
                </div>
            </form>
        </div>
    </div>