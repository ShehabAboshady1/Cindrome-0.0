<nav class="bar">
    <div class="nav-container">

        <a href="/" class="logo-link">
            <img class="logo" src="/assets/logos/no background logo.png" alt="Cindrome Logo">
        </a>

        <!-- الـ Checkbox لازم يفضل هنا عشان CSS الـ Hamburger يشتغل -->
        <input type="checkbox" id="menu-toggle" class="menu-checkbox">

        <!-- 1. روابط الـ Navigation العادية (بتختفي في الموبايل) -->
        <div class="right-bar">
            <a href="/" class="nav-item">Home</a>
            <a href="/discover" class="nav-item">Discover</a>
            <a href="/lists" class="nav-item">Lists</a>

            <div class="dropdown">
                <input type="checkbox" id="content-toggle" class="dropdown-checkbox">
                <label for="content-toggle" class="nav-item dropdown-label">Content ▾</label>
                <ul class="dropdown-menu">
                    <li><a href="/movies">Movies</a></li>
                    <li><a href="/series">TV Series</a></li>
                    <li><a href="/anime">Anime</a></li>
                </ul>
            </div>

            <a href="/drome" class="nav-item">Drome</a>

            <div class="dropdown user-only">
                <input type="checkbox" id="account-toggle" class="dropdown-checkbox">
                <label for="account-toggle" class="nav-item dropdown-label">
                    <% if (locals.user) { %>
                        <img src="<%= user.avatar_url || '/assets/avatars/default-avatar.jpeg' %>" alt="Profile"
                            onerror="this.onerror=null; this.src='/assets/avatars/default-avatar.jpeg';"
                            style="width: 25px; height: 25px; border-radius: 50%; vertical-align: middle; margin-right: 5px; object-fit: cover;">
                        <%= user.username %> ▾
                            <% } else { %>
                                Account ▾
                                <% } %>
                </label>
                <ul class="dropdown-menu">
                    <li><a href="/profile/<%= locals.user ? locals.user.username : '' %>">Profile</a></li>
                    <li><a href="/diary">Diary</a></li>
                    <li><a href="/watchlist">Watchlist</a></li>
                    <li><a href="/logout" style="color: #ff4757;">Log out</a></li>
                </ul>
            </div>
        </div>

        <!-- 🌟 2. زراير الأكشن والهامبرجر (بره القايمة عشان يظهروا دايماً) 🌟 -->
        <div class="nav-actions">
            <!-- للزوار بس -->
            <a href="/sign-in" class="guest-only" style="text-decoration: none;">
                <button class="signin-btn">Sign in</button>
            </a>

            <!-- للمستخدمين بس -->
            <button class="log-nav-btn user-only" id="navLogBtn">
                <i class="fa-solid fa-plus"></i> Log
            </button>

            <!-- زرار البحث -->
            <button type="button" class="search-trigger-btn" aria-label="Search">
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>

            <!-- زرار الهامبرجر -->
            <label for="menu-toggle" class="hamburger-btn">&#9776;</label>
        </div>

    </div>
</nav>