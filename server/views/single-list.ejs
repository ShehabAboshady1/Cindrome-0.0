        <!-- 1. HEADER -->
        <section class="single-list-header-section">
            <h1 class="single-list-title">Mind-Bending Masterpieces</h1>
            <div class="list-meta-info">
                <img src="/assets/logos/cindrome-logo.png" alt="User Avatar" class="list-author-avatar">
