<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome - <%= list.title %>
    </title>
    <link rel="icon" type="image/png" href="/assets/logos/cindrome-logo.png">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/mini-card.css">
    <link rel="stylesheet" href="/css/pages/watchlist.css">
    <link rel="stylesheet" href="/css/pages/single-list.css">
    <link rel="stylesheet" href="/css/modals.css">
</head>

<body class="<%= locals.user ? 'logged-in' : 'logged-out' %>">
    <!-- Navbar -->
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <main class="single-list-main-section">

        <!-- 1. HEADER (Dynamic) -->
        <section class="single-list-header-section">
            <h1 class="single-list-title"
                style="display: flex; align-items: center; justify-content: center; gap: 10px;">
                <%= list.title %>
                    <% if (list.is_private) { %>
                        <i class="fa-solid fa-lock" style="font-size: 0.6em; color: rgba(241, 227, 200, 0.6);"
                            title="Private List"></i>
                        <% } %>
            </h1>
            <div class="list-meta-info">
                <img src="<%= list.avatar_url || '/assets/logos/cindrome-logo.png' %>" alt="User Avatar"
                    class="list-author-avatar">
                <span class="list-author-name">A list by <a href="/profile/<%= list.username %>">@<%= list.username %>
                    </a></span>
                <% const dateObj=new Date(list.updated_at || list.created_at); const
                    dateStr=dateObj.toLocaleDateString('en-US', { year: 'numeric' , month: 'short' , day: 'numeric' });
                    %>
                    <span class="list-update-date">• Updated <%= dateStr %></span>
            </div>
        </section>

        <!-- 2. GRID SECTION -->
        <section class="single-list-grid-section">
            <div class="single-list-grid-container">

                <div class="grid-header-meta list-inline-header">
                    <div class="header-meta-left">
                        <span class="grid-count-text">
                            <%= listItems.length %> Titles
                        </span>
                        <div class="list-user-progress">
                            <svg class="progress-eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <!-- Progress is kept static visually until integrated with User Diary -->
                            <span class="progress-numbers">
                                <%= watchedCount %>/<%= listItems.length %>
                            </span>
                            <span class="progress-percentage">(<%= listItems.length> 0 ? Math.round((watchedCount /
                                    listItems.length) * 100) : 0 %>%)</span>
                        </div>
                    </div>

                    <div class="single-list-actions-inline">
                        <% if (isOwner) { %>
                            <button class="list-action-btn edit-list-btn" id="editListTriggerBtn"
                                style="border: 1px solid rgba(241, 227, 200, 0.2);">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 20h9"></path>
                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                                <span>Edit</span>
                            </button>
                            <button class="list-action-btn delete-list-btn" id="deleteListBtn"
                                data-list-id="<%= list.id %>"
                                style="border: 1px solid rgba(255, 71, 87, 0.4); color: #ff4757;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path
                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                    </path>
                                </svg>
                                <span>Delete</span>
                            </button>
                            <% } %>
                                <button class="list-action-btn like-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                        </path>
                                    </svg>
                                    <span>0</span>
                                </button>
                                <button class="list-action-btn share-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="18" cy="5" r="3"></circle>
                                        <circle cx="6" cy="12" r="3"></circle>
                                        <circle cx="18" cy="19" r="3"></circle>
                                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                    </svg>
                                    <span>Share</span>
                                </button>
                    </div>
                </div>

                <!-- شبكة الكروت الديناميكية -->
                <div class="single-list-cards-grid">
                    <% if (listItems && listItems.length> 0) { %>
                        <% listItems.forEach(item=> { %>
                            <!-- هنضيف الداتا عشان الجافاسكريبت يعرف إحنا بندوس على أي فيلم -->
                            <div class="mini-content-card" data-tooltip="<%= item.title %>"
                                data-id="<%= item.tmdb_id %>" data-type="<%= item.media_type %>">
                                <div class="mini-card-media">
                                    <img src="<%= item.poster_path ? 'https://image.tmdb.org/t/p/w500' + item.poster_path : '/assets/posters/poster-odyssey.webp' %>"
                                        alt="<%= item.title %>" class="mini-card-poster" loading="lazy">
                                    <div class="mini-top-rating">★ <%= item.rating ? Number(item.rating).toFixed(1)
                                            : 'NR' %>
                                    </div>
                                    <div class="mini-card-bar">
                                        <a href="/details?id=<%= item.tmdb_id %>&type=<%= item.media_type %>"
                                            class="mini-bar-btn btn-info" title="Details">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                                stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            </svg>
                                        </a>
                                        <!-- الزرار بينور لو هو في الوتش ليست ويقلب أيقونة ناقص -->
                                        <button
                                            class="mini-bar-btn btn-add <%= item.is_watchlisted ? 'is-added' : '' %>"
                                            title="<%= item.is_watchlisted ? 'Remove from Watchlist' : 'Add to Watchlist' %>">
                                            <% if (item.is_watchlisted) { %>
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                                    stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                                </svg>
                                                <% } else { %>
                                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                                        stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                                        stroke-linejoin="round">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                    <% } %>
                                        </button>
                                        <!-- زرار اللايك بينور لو متسجل -->
                                        <button class="mini-bar-btn btn-fav <%= item.is_liked ? 'is-favorited' : '' %>"
                                            title="Favorite">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                                                <path
                                                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div
                                        style="grid-column: 1 / -1; text-align: center; padding: 40px; color: rgba(241,227,200,0.5);">
                                        <p>No titles added to this list yet.</p>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </section>

        <!-- 3. MODERN COMMENTS SECTION -->
        <section id="comments-section" class="list-comments-wrapper">
            <div class="comments-container">
                <h2 class="comments-title">Comments <span class="comments-count">42</span></h2>

                <!-- إضافة تعليق رئيسي -->
                <div class="add-comment-box">
                    <img src="/assets/logos/cindrome-logo.png" alt="My Avatar" class="comment-avatar">
                    <div class="modern-input-wrapper">
                        <textarea class="comment-textarea" placeholder="Add a comment." rows="1"></textarea>
                        <button class="modern-post-btn" title="Post Comment">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="comments-divider"></div>

                <!-- قائمة التعليقات -->
                <div class="comments-list">

                    <!-- 🌟 تعليق أساسي 1 مع رد نشط (معاينة) 🌟 -->
                    <div class="comment-thread">
                        <div class="single-comment">
                            <img src="/assets/logos/cindrome-logo.png" alt="User" class="comment-avatar">
                            <div class="comment-content-wrapper">
                                <div class="comment-header">
                                    <span class="comment-user">@Ahmed_Ali</span>
                                    <span class="comment-time">2h</span>
                                </div>
                                <p class="comment-text">Great list! But where is Fight Club? It definitely deserves a
                                    spot here.</p>
                                <div class="comment-interactions">
                                    <button class="interaction-btn"><svg viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path
                                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                            </path>
                                        </svg> 12</button>
                                    <button class="interaction-btn reply-trigger"><svg viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path
                                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                            </path>
                                        </svg> Reply</button>
                                </div>

                                <!-- 🌟 صندوق الرد المتداخل (مفعّل للمعاينة بكلاس is-active) 🌟 -->
                                <div class="inline-reply-box is-active">
                                    <img src="/assets/logos/cindrome-logo.png" alt="My Avatar"
                                        class="comment-avatar small-avatar">
                                    <div class="modern-input-wrapper">
                                        <textarea class="comment-textarea" placeholder="Reply to @Ahmed_Ali."
                                            rows="1"></textarea>
                                        <button class="modern-post-btn" title="Send Reply">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                            </svg>
                                        </button>
                                    </div>
                                    <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                                </div>
                            </div>
                        </div>

                        <!-- الردود (Nested) -->
                        <div class="nested-replies">
                            <div class="single-comment reply-comment">
                                <img src="/assets/logos/cindrome-logo.png" alt="User"
                                    class="comment-avatar small-avatar">
                                <div class="comment-content-wrapper">
                                    <div class="comment-header">
                                        <span class="comment-user">@Shehab</span>
                                        <span class="comment-badge">Author</span>
                                        <span class="comment-time">1h</span>
                                    </div>
                                    <p class="comment-text">I thought about adding it, but decided to keep it strictly
                                        2010s and newer. Maybe in part 2!</p>
                                    <div class="comment-interactions">
                                        <button class="interaction-btn"><svg viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <path
                                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                                </path>
                                            </svg> 5</button>
                                        <button class="interaction-btn reply-trigger"><svg viewBox="0 0 24 24"
                                                fill="none" stroke="currentColor" stroke-width="2">
                                                <path
                                                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                                </path>
                                            </svg> Reply</button>
                                    </div>

                                    <!-- صندوق رد مجهز للرد الثاني (مخفي افتراضياً بدون is-active) -->
                                    <div class="inline-reply-box">
                                        <img src="/assets/logos/cindrome-logo.png" alt="My Avatar"
                                            class="comment-avatar small-avatar">
                                        <div class="modern-input-wrapper">
                                            <textarea class="comment-textarea" placeholder="Reply to @Shehab."
                                                rows="1"></textarea>
                                            <button class="modern-post-btn" title="Send Reply">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                                </svg>
                                            </button>
                                        </div>
                                        <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- تعليق أساسي 2 -->
                    <div class="comment-thread">
                        <div class="single-comment">
                            <img src="/assets/logos/cindrome-logo.png" alt="User" class="comment-avatar">
                            <div class="comment-content-wrapper">
                                <div class="comment-header">
                                    <span class="comment-user">@Nour99</span>
                                    <span class="comment-time">5h</span>
                                </div>
                                <p class="comment-text">Shutter Island is an absolute masterpiece. W list.</p>
                                <div class="comment-interactions">
                                    <button class="interaction-btn"><svg viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path
                                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                            </path>
                                        </svg> 3</button>
                                    <button class="interaction-btn reply-trigger"><svg viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path
                                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                            </path>
                                        </svg> Reply</button>
                                </div>

                                <div class="inline-reply-box">
                                    <img src="/assets/logos/cindrome-logo.png" alt="My Avatar"
                                        class="comment-avatar small-avatar">
                                    <div class="modern-input-wrapper">
                                        <textarea class="comment-textarea" placeholder="Reply to @Nour99."
                                            rows="1"></textarea>
                                        <button class="modern-post-btn" title="Send Reply">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                            </svg>
                                        </button>
                                    </div>
                                    <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>
    <!-- TEMPLATES FOR JAVASCRIPT COMMENTS -->
    <template id="mainCommentTemplate">
        <div class="comment-thread">
            <div class="single-comment">
                <img src="/assets/logos/cindrome-logo.png" alt="User" class="comment-avatar">
                <div class="comment-content-wrapper">
                    <div class="comment-header">
                        <span class="comment-user"></span>
                        <span class="comment-time">Just now</span>
                    </div>
                    <p class="comment-text"></p>
                    <div class="comment-interactions">
                        <button class="interaction-btn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path
                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                </path>
                            </svg> <span>0</span>
                        </button>
                        <button class="interaction-btn reply-trigger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path
                                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                </path>
                            </svg> Reply
                        </button>
                    </div>
                    <!-- Inline Reply Box -->
                    <div class="inline-reply-box">
                        <img src="/assets/logos/cindrome-logo.png" alt="My Avatar" class="comment-avatar small-avatar">
                        <div class="modern-input-wrapper">
                            <textarea class="comment-textarea" placeholder="Reply..." rows="1"></textarea>
                            <button class="modern-post-btn" title="Send Reply">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                </svg>
                            </button>
                        </div>
                        <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                    </div>
                </div>
            </div>
            <div class="nested-replies"></div>
        </div>
    </template>

    <template id="replyCommentTemplate">
        <div class="single-comment">
            <img src="/assets/logos/cindrome-logo.png" alt="User" class="comment-avatar small-avatar">
            <div class="comment-content-wrapper">
                <div class="comment-header">
                    <span class="comment-user"></span>
                    <span class="comment-time">Just now</span>
                </div>
                <p class="comment-text"></p>
                <div class="comment-interactions">
                    <button class="interaction-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path
                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                            </path>
                        </svg> <span>0</span>
                    </button>
                    <button class="interaction-btn reply-trigger">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path
                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                            </path>
                        </svg> Reply
                    </button>
                </div>
                <!-- Inline Reply Box -->
                <div class="inline-reply-box">
                    <img src="/assets/logos/cindrome-logo.png" alt="My Avatar" class="comment-avatar small-avatar">
                    <div class="modern-input-wrapper">
                        <textarea class="comment-textarea" placeholder="Reply..." rows="1"></textarea>
                        <button class="modern-post-btn" title="Send Reply">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                    <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                </div>
            </div>
        </div>
    </template>
    <!-- DELETE LIST CONFIRMATION MODAL -->
    <div class="log-modal-overlay" id="deleteListModal" style="display: none; z-index: 10000;">
        <div class="log-modal-container confirm-modal-container">
            <i class="fa-solid fa-trash-can confirm-icon"></i>
            <!-- ضفت هنا border: none عشان الخط اللي تحت العنوان يتشال ويبقى شبه الصورة بالظبط -->
            <h2 class="modal-main-title" style="justify-content: center; border-bottom: none; padding-bottom: 0;">Delete
                List?</h2>
            <p class="confirm-text">Are you sure you want to delete this list? This action cannot be undone.</p>
            <div class="confirm-actions">
                <button class="btn-cancel-confirm" id="cancelDeleteListBtn">Cancel</button>
                <button class="btn-danger-confirm" id="confirmDeleteListBtn">Delete</button>
            </div>
        </div>
    </div>
