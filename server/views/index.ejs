<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome</title>
    <link rel="icon" type="image/png" href="assets/logos/cindrome-logo.png">
    <link rel="stylesheet" href="css/main.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/hero.css">
    <link rel="stylesheet" href="css/cards.css">
    <link rel="stylesheet" href="css/lists-carousel.css">
    <link rel="stylesheet" href="css/carousel.css">
    <link rel="stylesheet" href="css/list.css">
    <link rel="stylesheet" href="css/modals.css">




</head>

<body class="logged-in">
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <main>
        <section class="hero-section"
            style="background-image: url('<%= heroMovie && heroMovie.backdrop ? heroMovie.backdrop : 'assets/backdrops/backdrop-odyssey1.webp' %>');">
            <div class="hero-overlay"></div>
            <div class="hero-container">
                <div class="hero-content">
                    <div class="hero-tags">
                        <span class="badge trending-badge">🔥 Trending #1</span>
                        <span class="badge category-badge">Movie</span>
                    </div>
                    <h1 class="hero-title">
                        <%= heroMovie ? heroMovie.title : 'The Odyssey' %>
                    </h1>
                    <div class="hero-meta">
                        <span class="rating">⭐ <%= heroMovie ? heroMovie.score : '8.5' %> <i>/ 10</i></span>
                        <span class="meta-dot">•</span>
                        <span class="duration">
                            <%= heroMovie ? heroMovie.duration : '2h 58m' %>
                        </span>
                        <span class="meta-dot">•</span>
                        <span class="year">
                            <%= heroMovie ? heroMovie.year : '2026' %>
                        </span>
                        <span class="meta-dot">•</span>
                        <span class="genre">
                            <%= heroMovie ? heroMovie.genres : 'Action, Adventure, Drama' %>
                        </span>
                    </div>
                    <p class="hero-description">
                        <%= heroMovie ? heroMovie.overview
                            : 'Follow the epic journey of Odysseus as he struggles to return home after the Trojan War...'
                            %>
                    </p>
                    <div class="hero-actions">
                        <a href="/details?id=<%= heroMovie ? heroMovie.id : '' %>&type=movie" class="btn btn-primary">
                            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                            View Movie
                        </a>

                        <button type="button" class="btn btn-secondary hero-watchlist-btn">
                            <span class="default-content">Add to Watchlist</span>
                            <span class="added-content"><i class="fa-solid fa-minus" style="margin-right: 6px;"></i>
                                Added</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 1️⃣ Trending Now (8 Cards) -->
        <section class="carousel-section">
            <div class="carousel-header">
                <h2 class="carousel-title">🔥 Trending Now</h2>
                <div class="carousel-controls">
                    <button class="carousel-btn" aria-label="Previous">&#10094;</button>
                    <button class="carousel-btn" aria-label="Next">&#10095;</button>
                </div>
            </div>
            <div class="carousel-track">
                <% if (trendingNow && trendingNow.length> 0) { %>
                    <% trendingNow.forEach(item=> { %>
                        <div class="content-card">
                            <img src="<%= item.poster %>" alt="<%= item.title %>" class="card-poster">
                            <div class="card-overlay">
                                <div class="card-top-row">
                                    <span class="type-badge">
                                        <%= item.type %>
                                    </span>
                                    <div class="rating-box"><span class="rating-label">TMDB</span><span
                                            class="rating-score">⭐ <%= item.score %></span></div>
                                </div>
                                <div class="card-bottom-content">
                                    <div class="title-row">
                                        <h3 class="card-title">
                                            <%= item.title %>
                                        </h3>
                                        <span class="age-badge">
                                            <%= item.ageBadge %>
                                        </span>
                                    </div>
                                    <div class="meta-row">
                                        <span>
                                            <%= item.subtitle %>
                                        </span>
                                    </div>
                                    <div class="card-actions">
                                        <a href="/details?id=<%= item.id %>&type=<%= item.mediaType %>"
                                            class="btn-details">Details</a>
                                        <button class="btn-watchlist" title="Toggle Watchlist">
                                            <span class="icon-plus">+</span>
                                            <span class="icon-minus">-</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } %>
            </div>
        </section>

        <!-- 2️⃣ Must-Watch Movies (8 Cards - Using 1 Image Asset & Correct IMDb Rating) -->
        <section class="carousel-section">
            <div class="carousel-header">
                <h2 class="carousel-title">🎬 Must-Watch Movies</h2>
                <div class="carousel-controls">
                    <button class="carousel-btn" aria-label="Previous">&#10094;</button>
                    <button class="carousel-btn" aria-label="Next">&#10095;</button>
                </div>
            </div>
            <div class="carousel-track">
                <% if (mustWatchMovies && mustWatchMovies.length> 0) { %>
