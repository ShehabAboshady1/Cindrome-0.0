                                        <button class="btn-watchlist" title="Toggle Watchlist">
                                            <span class="icon-plus">+</span>
                                            <span class="icon-minus">-</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } %>
        </section>

        <section class="lists-section">
            <div class="carousel-header">
                <h2 class="carousel-title">🍿 Fan-Made Anime Lists</h2>
                <div class="carousel-controls">
                    <button class="carousel-btn" aria-label="Previous">&#10094;</button>
                    <button class="carousel-btn" aria-label="Next">&#10095;</button>
                </div>
            </div>

            <div class="lists-track">

                <!-- List Card 1: Ultimate Shonen Starter Pack -->
                <div class="list-card">
                    <div class="poster-stack">
                        <img src="assets/posters/poster-demonslayer.webp" alt="Demon Slayer" class="stack-poster">
                        <img src="assets/posters/poster-jjk.webp" alt="Jujutsu Kaisen" class="stack-poster">
                        <img src="assets/posters/poster-aot.webp" alt="Attack on Titan" class="stack-poster">
                        <img src="assets/posters/poster-fmab.webp" alt="Fullmetal Alchemist: Brotherhood"
                            class="stack-poster">
                    </div>
                    <div class="list-info">
                        <a href="/single-list" class="list-title">Ultimate Shonen Starter Pack</a>
                        <div class="list-meta">
                            <div>
                                <span class="user-badge">By @Shehab</span>
                                <span class="list-items-count">• 15 Titles</span>
                            </div>
                            <div class="list-actions">
                                <button class="list-action-btn like-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                        </path>
                                    </svg>
                                    <span>1.2k</span>
                                </button>
                                <a href="/single-list" class="list-action-btn comment-btn" title="Comment"
                                    style="text-decoration: none;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                        </path>
                                    </svg>
                                    <span>85</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- List Card 2: Mind Games & Masterminds -->
                <div class="list-card">
                    <div class="poster-stack">
                        <img src="assets/posters/poster-deathnote.webp" alt="Death Note" class="stack-poster">
                        <img src="assets/posters/poster-vinlandsaga.webp" alt="Vinland Saga" class="stack-poster">
                        <img src="assets/posters/poster-aot.webp" alt="Attack on Titan" class="stack-poster">
                        <img src="assets/posters/poster-fmab.webp" alt="Fullmetal Alchemist: Brotherhood"
                            class="stack-poster">
                    </div>
                    <div class="list-info">
                        <a href="/single-list" class="list-title">Mind Games & Masterminds</a>
                        <div class="list-meta">
                            <div>
                                <span class="user-badge">By @Alex</span>
                                <span class="list-items-count">• 10 Titles</span>
                            </div>
                            <div class="list-actions">
                                <button class="list-action-btn like-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                        </path>
                                    </svg>
                                    <span>940</span>
                                </button>
                                <a href="/single-list" class="list-action-btn comment-btn" title="Comment"
                                    style="text-decoration: none;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                        </path>
                                    </svg>
                                    <span>63</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- List Card 3: Best Sports & High-Hype Anime -->
                <div class="list-card">
                    <div class="poster-stack">
                        <img src="assets/posters/poster-haikyuu.webp" alt="Haikyu!!" class="stack-poster">
                        <img src="assets/posters/poster-ippo.webp" alt="Hajime no Ippo" class="stack-poster">
                        <img src="assets/posters/poster-demonslayer.webp" alt="Demon Slayer" class="stack-poster">
                        <img src="assets/posters/poster-jjk.webp" alt="Jujutsu Kaisen" class="stack-poster">
                    </div>
                    <div class="list-info">
                        <a href="/single-list" class="list-title">Best Sports & High-Hype Anime</a>
                        <div class="list-meta">
                            <div>
                                <span class="user-badge">By @Sarah_M</span>
                                <span class="list-items-count">• 8 Titles</span>
                            </div>
                            <div class="list-actions">
                                <button class="list-action-btn like-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                        </path>
                                    </svg>
                                    <span>2.5k</span>
                                </button>
                                <a href="/single-list" class="list-action-btn comment-btn" title="Comment"
                                    style="text-decoration: none;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                        </path>
                                    </svg>
                                    <span>142</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- List Card 4: Masterpiece Dark Stories -->
                <div class="list-card">
                    <div class="poster-stack">
                        <img src="assets/posters/poster-vinlandsaga.webp" alt="Vinland Saga" class="stack-poster">
                        <img src="assets/posters/poster-aot.webp" alt="Attack on Titan" class="stack-poster">
                        <img src="assets/posters/poster-deathnote.webp" alt="Death Note" class="stack-poster">
                        <img src="assets/posters/poster-fmab.webp" alt="Fullmetal Alchemist: Brotherhood"
                            class="stack-poster">
                    </div>
                    <div class="list-info">
                        <a href="/single-list" class="list-title">Masterpiece Dark Stories</a>
                        <div class="list-meta">
                            <div>
                                <span class="user-badge">By @JohnDoe</span>
                                <span class="list-items-count">• 12 Titles</span>
                            </div>
                            <div class="list-actions">
                                <button class="list-action-btn like-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                        </path>
                                    </svg>
                                    <span>3.1k</span>
                                </button>
                                <a href="/single-list" class="list-action-btn comment-btn" title="Comment"
                                    style="text-decoration: none;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                        </path>
                                    </svg>
                                    <span>215</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
        <%- include("partials/footer.ejs") %>
            <%- include("partials/modals/search-modal.ejs") %>
                <%- include("partials/modals/log-modal.ejs") %>
                    <script src="js/modals.js"></script>
                    <script src="js/carousel.js"></script>
                    <script src="js/pages/index-page.js"></script>
</body>

</html>