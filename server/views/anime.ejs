                                        <span class="age-badge">
                                            <%= item.ageBadge %>
                                        </span>
                                    </div>
                                    <div class="meta-row">
                                        <span>
                                            <%= item.meta %>
                                        </span>
                                    </div>
                                    <div class="card-actions">
