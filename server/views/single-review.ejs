<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cindrome - Review by @<%= review.username %>
    </title>
    <link rel="icon" type="image/png" href="/assets/logos/cindrome-logo.png">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/pages/single-review.css">
    <link rel="stylesheet" href="/css/modals.css">
    <link rel="stylesheet" href="/css/comments-section.css">
</head>

<body class="single-review-page <%= locals.user ? 'logged-in' : 'logged-out' %>">
    <!-- Navbar -->
    <header>
        <%- include("partials/navbar.ejs") %>
    </header>

    <!-- Main Content -->
    <main class="single-review-main">

        <!-- Backdrop Section (استخدمنا الباك دروب الحقيقي العريض من TMDB) -->
        <section class="review-backdrop-wrapper"
            style="background-image: url('<%= review.backdrop_path ? 'https://image.tmdb.org/t/p/original' + review.backdrop_path : (review.poster_path ? 'https://image.tmdb.org/t/p/w1000_and_h563_face' + review.poster_path : '/assets/backdrops/backdrop-odyssey1.webp') %>');">
            <div class="backdrop-gradient-overlay"></div>
        </section>
        <!-- Review Content Container -->
        <section class="review-content-container">

            <!-- 1. EXTERNAL MOVIE INFO (Dynamic) -->
            <div class="external-movie-header">
                <a href="/details?id=<%= review.tmdb_id %>&type=<%= review.media_type %>" class="external-poster-link">
                    <img src="<%= review.poster_path ? 'https://image.tmdb.org/t/p/w500' + review.poster_path : '/assets/posters/poster-odyssey.webp' %>"
                        alt="<%= review.title %> Poster" class="external-main-poster">
                </a>

                <div class="external-movie-info">
                    <h1 class="external-movie-title"><a
                            href="/details?id=<%= review.tmdb_id %>&type=<%= review.media_type %>">
                            <%= review.title %>
                        </a></h1>
                    <!-- لو العمل مسلسل وله موسم وحلقة، نظهر الـ Pill -->
                    <% if (review.season_number && review.episode_number) { %>
                        <div class="episode-meta-pill">
                            Season <%= review.season_number %> • Episode <%= review.episode_number %>
                        </div>
                        <% } %>
                </div>
            </div>

            <!-- 2. THE REVIEW CARD (Dynamic) -->
            <article class="review-card-unified">

                <!-- Card Header -->
                <div class="card-user-header">

                    <div class="reviewer-meta-inside">
                        <a href="/profile/<%= review.username %>"><img
                                src="<%= review.avatar_url || '/assets/profile-avatar.jpg' %>"
                                alt="<%= review.username %>" class="card-avatar"
                                onerror="this.src='/assets/profile-avatar.jpg'"></a>
                        <div class="card-user-details">
                            <span class="card-username"><a href="/profile/<%= review.username %>">@<%= review.username
                                        %></a></span>
                            <div class="card-rating-date">
                                <!-- رسم النجوم ديناميكياً (بالشكل الموحد للموقع) -->
                                <% if (review.rating) { %>
                                    <span class="stars" title="<%= review.rating %> Stars">
                                        <% const fullStars=Math.floor(review.rating); const hasHalf=review.rating % 1
                                            !==0; for(let i=0; i<fullStars; i++) { %>★<% } %>
                                                <% if(hasHalf) { %><span class="half-star">★</span>
                                                    <% } %>
                                    </span>
                                    <% } %>

                                        <!-- رسم القلب لو اختار انه عاجبه -->
                                        <% if (review.liked) { %>
                                            <i class="fa-solid fa-heart favorite-heart" title="Favorited"></i>
                                            <% } %>

                                                <% if (review.rating || review.liked) { %>
                                                    <span class="dot-divider">•</span>
                                                    <% } %>

                                                        <span class="review-date">
                                                            <% const d=new Date(review.watch_date || review.created_at);
                                                                %>
                                                                <%= d.toLocaleDateString('en-US', { month: 'long' ,
                                                                    day: 'numeric' , year: 'numeric' }) %>
                                                        </span>
                            </div>
                        </div>
                    </div>

                    <!-- علامة السبويلر -->
                    <% if (review.has_spoilers) { %>
                        <div class="card-spoiler-badge" id="spoilerBadge">
                            <i class="fa-solid fa-triangle-exclamation"></i> Spoiler
                        </div>
                        <% } %>
                </div>

                <hr class="card-divider">

                <!-- Review Text (Dynamic) -->
                <div id="reviewTextWrapper" class="review-text-wrapper <%= review.has_spoilers ? 'is-spoiler' : '' %>"
                    <%=review.has_spoilers ? 'title="Click to reveal spoiler"' : '' %>>
                    <div class="review-text <%= review.has_spoilers ? 'blurred-text' : '' %>">
                        <% if (review.review_text && review.review_text.trim() !=='' ) { const
                            paragraphs=review.review_text.split('\n'); paragraphs.forEach(p=> {
                            if (p.trim() !== '') { %>
                            <p>
                                <%= p %>
                            </p>
                            <% } }); } else { %>
                                <p style="opacity: 0.5; font-style: italic;">This user logged the title without a
                                    written review.</p>
                                <% } %>
                    </div>
                </div>

                <hr class="actions-divider">

                <!-- 🌟 Actions (Dynamic Likes Count) 🌟 -->
                <div class="review-actions-bar">
                    <!-- Like SVG Button -->
                    <button class="action-btn like-btn <%= isLikedByCurrentUser ? 'is-liked' : '' %>" id="reviewLikeBtn"
                        aria-label="Like Review">
                        <svg class="interactive-svg like-svg" viewBox="0 0 24 24" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                            </path>
                        </svg>
                        <span class="action-count">
                            <%= likesCount %>
                        </span>
                    </button>
                    <!-- Share SVG Button -->
                    <button class="action-btn share-btn" id="reviewShareBtn" aria-label="Share Review"
                        title="Copy link">
                        <svg class="interactive-svg share-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </button>
                </div>
            </article>
            <!-- 3. MODERN COMMENTS SECTION (Partial) -->
            <%- include("partials/comments-section.ejs") %>


        </section>
        <!-- Template للكومنت الجديد عشان الجافاسكريبت يستخدمه بدون ما نكتب HTML جواه -->
        <template id="commentTemplate">
            <div class="comment-thread">
                <div class="single-comment">
                    <img src="" alt="User" class="comment-avatar" onerror="this.src='/assets/profile-avatar.jpg'">
                    <div class="comment-content-wrapper">
                        <div class="comment-header">
                            <span class="comment-user"></span>
                            <span class="comment-time">Just now</span>
                        </div>
                        <p class="comment-text"></p>
                        <div class="comment-interactions">
                            <button class="interaction-btn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path
                                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                                    </path>
                                </svg> 0
                            </button>
                            <button class="interaction-btn reply-trigger">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path
                                        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                    </path>
                                </svg> Reply
                            </button>
                        </div>
                        <div class="inline-reply-box">
                            <img src="" alt="My Avatar" class="comment-avatar small-avatar reply-avatar"
                                onerror="this.src='/assets/profile-avatar.jpg'">
                            <div class="modern-input-wrapper">
                                <textarea class="comment-textarea" placeholder="Reply..." rows="1"></textarea>
                                <button class="modern-post-btn" title="Send Reply">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                </button>
                            </div>
                            <button class="reply-cancel-btn" title="Cancel Reply">Cancel</button>
                        </div>
                    </div>
                </div>
                <div class="nested-replies"></div>
            </div>
        </template>
    </main>

    <%- include("partials/footer.ejs") %>
        <%- include("partials/modals/search-modal.ejs") %>
            <%- include("partials/modals/log-modal.ejs") %>

                <!-- Scripts -->
                <script src="/js/modals.js"></script>
                <script src="/js/comments-section.js"></script>
                <script src="/js/pages/single-review.js"></script>
</body>

</html>